menu "Zephyr Image Storage Setup"
	depends on LOAD_ZEPHYR

config SAMA7D65_CURIOSITY_SPLASH
	bool "Early LVDS splash for SAMA7D65 Curiosity (non-Pro)"
	depends on SAMA7D65 && SDCARD && !FAST_BOOT && !BACKUP_MODE && !SECURE
	help
	  Start the 1280x800 zero_gfx panel before SD loading. BASE uses a
	  constant color without DMA; a compact indexed OVR1 logo/progress
	  framebuffer occupies the final 64 KiB of DDR. The application must
	  keep this range unused until its display driver takes over.

config IMG_ADDRESS
	string "Flash Offset for Zephyr Image"
	depends on DATAFLASH || FLASH || NANDFLASH
	default "0x00008000" if FLASH
	default "0x00008000" if DATAFLASH
	default "0x00040000" if NANDFLASH
	default	"0x00000000" if SDCARD


config IMG_SIZE
	string "Zephyr Image Size"
	depends on DATAFLASH || FLASH || NANDFLASH
	default	"0x00100000"
	help
	  at91bootstrap will copy this size of Zephyr image

config JUMP_ADDR
	string "The External Ram Address to Load Zephyr Image"
	default "0x20000000" if SAMA5D2
	default "0x60000000" if SAMA7G5 || SAMA7D65
	help
	  The entry point to which the bootstrap will pass control.

endmenu
